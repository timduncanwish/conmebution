// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// 用户模型
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  avatar        String?
  language      String    @default("zh")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关系
  contentTemplates ContentTemplate[]
  contentHistory   ContentHistory[]
  platformCredentials PlatformCredential[]
  workflowTasks    WorkflowTask[]
  scheduledPosts     ScheduledPost[]
  ideas            Idea[]
  postingSchedules PostingSchedule[]
  engagements      Engagement[]
  aiProviderConfigs AiProviderConfig[]
  setting          UserSetting?

  @@map("users")
}

// AI provider 配置 (F11 — API 密钥按用户加密存储)
model AiProviderConfig {
  id        String   @id @default(cuid())
  userId    String
  provider  String   // glm-4, gpt-4, gemini-pro, doubao
  apiKey    String   @map("api_key") // AES-256-GCM 加密存储,不回传明文
  priority  Int      @default(1)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("ai_provider_configs")
}

// 用户级设置 (F11 — 预算与自动选择)
model UserSetting {
  id                  String   @id @default(cuid())
  userId              String   @unique
  monthlyBudget       Int      @default(500) @map("monthly_budget")
  autoSelectCheapest  Boolean  @default(true) @map("auto_select_cheapest")
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// 互动消息 (F12 — 借鉴 Buffer Community)
model Engagement {
  id                   String    @id @default(cuid())
  userId               String
  distributionRecordId String?   @map("distribution_record_id")
  contentId            String?   @map("content_id")
  platform             String
  type                 String    @default("comment") // comment, dm
  externalId           String    @map("external_id") // 平台侧消息 ID(Mock 用合成 ID)
  authorName           String    @map("author_name")
  content              String
  status               String    @default("unread") // unread, replied
  reply                String?
  repliedAt            DateTime? @map("replied_at")
  createdAt            DateTime  @default(now())

  // 关系
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  distributionRecord DistributionRecord? @relation(fields: [distributionRecordId], references: [id], onDelete: SetNull)

  @@unique([userId, externalId])
  @@map("engagements")
}

// 发布队列时间槽 (F8 — 借鉴 Buffer Publish/Queue)
model PostingSchedule {
  id          String   @id @default(cuid())
  userId      String
  platform    String   // 每个渠道一套时间槽
  timeSlots   String   @map("time_slots") // JSON 数组,如 ["12:00","19:00"]
  timezone    String   @default("Asia/Shanghai")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关系
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledPosts  ScheduledPost[]

  @@unique([userId, platform])
  @@map("posting_schedules")
}

// 灵感收件箱 (F7 — 借鉴 Buffer Create/Ideas)
model Idea {
  id          String   @id @default(cuid())
  userId      String
  title       String
  note        String?
  tags        String?  // JSON 数组
  status      String   @default("pending") // pending, generated, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关系
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentHistory  ContentHistory[]

  @@map("ideas")
}

// 内容模板
model ContentTemplate {
  id             String   @id @default(cuid())
  userId         String
  name           String
  description     String?
  type           String   // text, image, video, all
  promptTemplate String   @map("prompt_template")
  aiProvider     String   @map("ai_provider")
  style          String?
  platforms      String? // JSON
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 关系
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentHistory  ContentHistory[]

  @@map("content_templates")
}

// 生成历史
model ContentHistory {
  id               String   @id @default(cuid())
  userId           String
  templateId        String?  @map("template_id")
  ideaId           String?  @map("idea_id")
  prompt           String
  type             String   // text, image, video, all
  generatedContent  String   @map("generated_content") // JSON
  aiProvider       String   @map("ai_provider")
  cost             Int?
  status           String   @default("draft") // draft, generated, published
  createdAt        DateTime @default(now())

  // 关系
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template         ContentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  idea             Idea?    @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  distributionRecords DistributionRecord[]
  scheduledPosts     ScheduledPost[]

  @@map("content_history")
}

// 平台凭证
model PlatformCredential {
  id              String    @id @default(cuid())
  userId          String
  platform        String    // douyin, bilibili, xiaohongshu, youtube, twitter, medium
  accountName      String    @map("account_name")
  accessToken     String    @map("access_token")  // 加密
  refreshToken    String?   @map("refresh_token") // 加密
  expiresAt       DateTime? @map("expires_at")
  status          String    @default("active") // active, inactive, expired
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 关系
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_credentials")
}

// 分发记录
model DistributionRecord {
  id                String   @id @default(cuid())
  contentId         String   @map("content_id")
  userId           String
  platform          String
  platformPostId    String?  @map("platform_post_id")
  platformUrl       String?  @map("platform_url")
  status            String   // pending, success, failed
  errorMessage      String?  @map("error_message")
  views             Int      @default(0)
  likes             Int      @default(0)
  shares            Int      @default(0)
  metricsSyncedAt   DateTime? @map("metrics_synced_at")
  publishedAt        DateTime? @map("published_at")
  createdAt         DateTime @default(now())

  // 关系
  content           ContentHistory @relation(fields: [contentId], references: [id], onDelete: Cascade)
  engagements       Engagement[]

  @@map("distribution_records")
}

// 工作流任务
model WorkflowTask {
  id             String   @id @default(cuid())
  userId         String
  workflowType  String   @map("workflow_type")
  inputData      String   @map("input_data") // JSON
  status         String   @default("pending") // pending, running, completed, failed
  currentStep    String?  @map("current_step")
  result         String?  @map("result") // JSON
  error          String?
  createdAt      DateTime @default(now())
  completedAt    DateTime? @map("completed_at")

  // 关系
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workflow_tasks")
}

// 定时发布
model ScheduledPost {
  id                String   @id @default(cuid())
  userId            String
  contentId          String   @map("content_id")
  postingScheduleId String?  @map("posting_schedule_id")
  platforms         String   // JSON
  scheduledTime     DateTime @map("scheduled_time")
  timezone         String   @default("Asia/Shanghai")
  status            String   @default("pending") // pending, sent, failed, cancelled
  error             String?
  createdAt         DateTime @default(now())

  // 关系
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content         ContentHistory @relation(fields: [contentId], references: [id], onDelete: Cascade)
  postingSchedule PostingSchedule? @relation(fields: [postingScheduleId], references: [id], onDelete: SetNull)

  @@map("scheduled_posts")
}
