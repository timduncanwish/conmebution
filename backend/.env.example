# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Database Configuration (runtime uses backend/prisma/dev.db)
DATABASE_URL=file:./prisma/dev.db

# AI Mode: true = Mock (no key needed); false = real API calls
USE_MOCK_AI=true

# AI Service Configuration — at least one key when USE_MOCK_AI=false
# GLM_MODEL 默认 glm-4.5-flash(免费)。编码套餐(Coding Plan)可用 glm-4.6/glm-5.1/glm-5.2 等。
# 编码套餐需把 GLM_BASE_URL 指向编码端点:https://open.bigmodel.cn/api/coding/paas/v4
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.5-flash
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DOUBAO_API_KEY=your_doubao_api_key_here

# Redis Configuration (for job queues and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage Configuration
STORAGE_TYPE=local
UPLOAD_PATH=./uploads

