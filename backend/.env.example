# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Database Configuration (runtime uses backend/prisma/dev.db)
DATABASE_URL=file:./prisma/dev.db

# AI Mode: true = Mock (no key needed); false = real API calls
USE_MOCK_AI=true

# AI Service Configuration — at least one key when USE_MOCK_AI=false
# GLM_MODEL optional, defaults to glm-4-flash (free tier)
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4-flash
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DOUBAO_API_KEY=your_doubao_api_key_here

# Redis Configuration (for job queues and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage Configuration
STORAGE_TYPE=local
UPLOAD_PATH=./uploads

